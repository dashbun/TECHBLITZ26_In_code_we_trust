# ============================================================
# Aura Sales Autopilot — Environment Variables
# Fill in real values before running.
# ============================================================

# Supabase (required for all DB operations)
SUPABASE_URL=https://fbvpyjxmxtebqqypriiy.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Telegram bots
TELEGRAM_USER_BOT_TOKEN=your_telegram_user_bot_token
TELEGRAM_REP_BOT_TOKEN=your_telegram_rep_bot_token
TELEGRAM_REP_CHAT_ID=your_rep_telegram_chat_id

# Lead scoring thresholds
SCORE_HIGH=70
SCORE_MEDIUM=40

# Twilio / WhatsApp
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
WHATSAPP_REP_NUMBER=whatsapp:+1234567890

# Apollo.io enrichment
APOLLO_IO_KEY=your_apollo_io_key
